{
  "model": "CMF",
  "results_root": "results",
  "seeds": [12345, 23451, 34512, 45123, 51234],
  "epochs": 100,
  "scenarios": [1, 2, 3, 4, 5],
  "datasets": {
    "dataset_16": "Dataset/NPZ_spatial/dataset_16.npz"
  },
  "callbacks": {
    "early_stopping_patience": 12,
    "lr_reduce_patience": 6,
    "lr_reduce_factor": 0.5,
    "lr_reduce_min_lr": 1e-6,
    "min_delta": 1e-4
  },
  "ablation_grid": {
    "dsm_mode": ["dsm_only"],
    "variant": ["3stream_concat", "3stream_no_concat", "4stream"],
    "residual": [true, false],
    "fusion": ["sub", "concat", "mcmaf"]
  },
  "hpo_grid": {
    "optimizer": ["Adam", "Nadam", "SGD"],
    "learning_rate": [0.0001, 0.001],
    "batch_size": [64, 128, 256]
  }
}
